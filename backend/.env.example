# Security Settings
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.vercel.app,pankaj-patel-portfolio.vercel.app

# Protected Endpoints
RESUME_UPLOAD_PASSWORD=your-secure-resume-upload-secret
VISITOR_LOG_SECRET=your-secure-visitor-log-secret

# Database Options
# For SQLite locally, leave blank.
# For MySQL locally or in production, configure either DATABASE_URL or MYSQL_URL
# Example: mysql://root:password@127.0.0.1:3306/portfolio_db
DATABASE_URL=
MYSQL_URL=

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://pankaj-patel-portfolio.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://*.railway.app,https://*.vercel.app,https://pankaj-patel-portfolio.vercel.app

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# Use an App Password if using Gmail (e.g. from Google Account > Security > 2-Step Verification > App passwords)
EMAIL_HOST_PASSWORD=your-app-password
ADMIN_NOTIFICATION_EMAIL=pankajlucky678@gmail.com
DEFAULT_FROM_EMAIL=Pankaj Patel Portfolio <your-email@gmail.com>
